# Local development only. Copy to .env; never reuse these passwords in AWS.

# Postgres superuser: creates roles and seeds tests, never used by the app.
POSTGRES_PASSWORD=dev-postgres
# av_owner owns the tables and runs migrations; av_app is used by the API and workers.
AV_OWNER_PASSWORD=dev-owner
AV_APP_PASSWORD=dev-app
POSTGRES_PORT=5432

# Mongo root user.
MONGO_PASSWORD=dev-mongo
MONGO_PORT=27017

# Connection URLs used by the Python code.
OWNER_DATABASE_URL=postgresql+psycopg://av_owner:dev-owner@127.0.0.1:5432/av
MONGO_URL=mongodb://root:dev-mongo@127.0.0.1:27017/?authSource=admin&retryWrites=false
MONGO_DB=av
